{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdPad",
  "version": "0.2.0",
  "identifier": "com.mdpad.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MdPad",
        "create": false,
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNjNDNzQzMTI4NzI5QjIKUldTeUtZY1NROGRqUU94NC9weWN1NzBiemtiejNvdnNLVG1FS3NOUVhOR3I1TlRMY0NINXRMNFgK",
      "endpoints": [
        "https://github.com/coolzifan123/mdpad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
